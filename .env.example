# === Telehack configuration ===
APP_NAME=Telehack

# Public base URL used in login-link emails (e.g. https://your-domain)
BASE_URL=http://localhost:8800

# Comma-separated emails registered as admins at startup
ADMIN_EMAILS=admin@example.com

# --- LiveKit ---
LIVEKIT_URL=http://localhost:7880
# WebSocket URL as seen from the browser (wss://your-domain when behind the reverse proxy)
LIVEKIT_WS_URL=ws://localhost:7880
# Must match the key/secret in livekit/livekit.yaml and livekit/egress.yaml
LIVEKIT_API_KEY=CHANGE_ME_KEY
LIVEKIT_API_SECRET=CHANGE_ME_SECRET

# --- Email (leave SMTP_HOST empty for dev mode: links are printed to the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=noreply@example.com

# --- Auth ---
LOGIN_TOKEN_TTL_MIN=15
SESSION_TTL_HOURS=24
