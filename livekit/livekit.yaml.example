port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50199
  # true when exposed to the internet: discovers the external IP via STUN
  # and uses it in ICE candidates
  use_external_ip: true
redis:
  address: redis:6379
keys:
  # Must match LIVEKIT_API_KEY / LIVEKIT_API_SECRET in .env and egress.yaml
  CHANGE_ME_KEY: CHANGE_ME_SECRET
webhook:
  api_key: CHANGE_ME_KEY
  urls:
    # The app server (auto-recording relies on these events)
    - http://host.docker.internal:8800/api/lk-webhook
logging:
  level: info
